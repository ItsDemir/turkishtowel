# Copy this file to .env and fill in your own values. Never commit .env.

# Stripe: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Locally this is printed by `stripe listen`. In production it comes from the
# webhook endpoint you create in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend: https://resend.com/api-keys
RESEND_API_KEY=re_...

PORT=3000

# Optional settings

# Public address of the site. Used for Stripe return URLs and links in emails.
# Defaults to http://localhost:PORT
SITE_URL=http://localhost:3000

# Sender shown on order confirmation emails. Use an address on a domain you have
# verified in Resend. The default below is Resend's sandbox sender, which only
# delivers to the email address of your own Resend account.
EMAIL_FROM=Pamuq <onboarding@resend.dev>

# Turso, SQLite in the cloud. Set both to keep orders, stock, sign ups, reviews
# and messages in Turso instead of a local file. Required on Vercel for anything
# to last between requests.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Location of the SQLite file when Turso is not set.
DATABASE_PATH=./pamuq.db

# Turn on after enabling Stripe Tax in the Stripe Dashboard, so US sales tax is
# calculated at checkout.
# STRIPE_AUTOMATIC_TAX=1

# Support and company details, shown on the contact page and in the policies.
# Contact form messages are emailed to SUPPORT_EMAIL. CAN-SPAM requires the
# mailing address in every marketing email.
SUPPORT_EMAIL=
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=

# Optional: also add newsletter sign ups to a Klaviyo list.
KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=

# Turn on after enabling Web Analytics in the Vercel project.
# VERCEL_ANALYTICS=1

# Set to off to serve photos without Vercel Image Optimization.
# IMAGE_OPTIMIZER=off
